# Frontend
node_modules/
dist/

# Rust / Tauri (build output and generated schemas)
src-tauri/target/
src-tauri/gen/schemas/

# Original full-size art (1-2 MB each). Only the small copies made by
# tools/make-brand-images.ps1 are committed.
media/
# 1024 px icon source made from media/ by the same script (the generated icon sizes are committed)
src-tauri/icons/app-icon.png

# The bundled tools (yt-dlp, Deno, FFmpeg; ~130 MB). tools/fetch-tools.ps1 downloads
# the pinned versions from src-tauri/tools.json; the Release workflow does the same.
src-tauri/tools/

# Other AI tools' separate working copies of this repo
worktrees/

# Partial downloads, if yt-dlp is ever run from this folder
*.part
*.ytdl

# OS clutter
.DS_Store
Thumbs.db

# Personal Claude Code settings
.claude/settings.local.json
